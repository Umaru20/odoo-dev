map $sent_http_content_type $content_type_csp {
    default "";
    ~image/ "default-src 'none'";
}

# http redirect
server {
    listen 80;
    server_name ${ODOO_HOSTNAME} ${NGINX_HOSTNAME} ${PGADMIN_HOSTNAME} ;
    underscores_in_headers on;

    location / {
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Prefix /;

        return 301 https://$host$request_uri;
    }
}

# Odoo
server {
    listen 443 ssl;
    server_name ${ODOO_HOSTNAME};
    underscores_in_headers on;

    ssl_certificate /etc/certs/$host.pem;
    ssl_certificate_key /etc/certs/$host-key.pem;

    location / {
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Prefix /;

        proxy_pass http://odoo-dev:${ODOO_PORT};
    }
}

# PgAdmin
server {
    listen 443 ssl;
    server_name ${PGADMIN_HOSTNAME};
    underscores_in_headers on;

    ssl_certificate /etc/certs/$host.pem;
    ssl_certificate_key /etc/certs/$host-key.pem;

    ssl_session_cache builtin:1000 shared:SSL:10m;
    ssl_protocols TLSv1 TLSv1.1 TLSv1.2;
    ssl_ciphers HIGH:!aNULL:!eNULL:!EXPORT:!CAMELLIA:!DES:!MD5:!PSK:!RC4;
    ssl_prefer_server_ciphers on;

    location / {
        proxy_set_header X-Scheme $scheme;
        proxy_set_header Host $host;

        proxy_pass http://pgadmin-dev:${PGADMIN_PORT}/;

        # Fix trailing slash redirects
        proxy_redirect off;

    }
}